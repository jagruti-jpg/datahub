# Copy to .env and fill in. Used by docker-compose.yml (never commit the real .env).

# Claude API key (required) — from your Anthropic account.
ANTHROPIC_API_KEY=sk-ant-...

# DataHub GMS auth token (required if GMS runs with METADATA_SERVICE_AUTH_ENABLED=true).
# Generate one in the DataHub UI: Settings → Access Tokens.
DATAHUB_GMS_TOKEN=
