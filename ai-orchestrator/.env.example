# Copy to .env and fill in. Used by docker-compose.yml (never commit the real .env).
# Only the two REQUIRED vars below need values; everything else has a working
# default baked into docker-compose.yml / the code. Uncomment to override.

# ── Required ────────────────────────────────────────────────────────────────

# Claude API key (required) — from your Anthropic account.
ANTHROPIC_API_KEY=sk-ant-...

# DataHub GMS auth token (required if GMS runs with METADATA_SERVICE_AUTH_ENABLED=true).
# Generate one in the DataHub UI: Settings → Access Tokens.
DATAHUB_GMS_TOKEN=

# ── Chat model (optional) ───────────────────────────────────────────────────
# Model + limits for the agent loop (agent.py).

# ANTHROPIC_MODEL=claude-sonnet-5      # claude-haiku-4-5 is ~2x faster / cheaper
# ANTHROPIC_MAX_TOKENS=4096
# MAX_TOOL_ITERATIONS=10               # agent-loop ceiling

# ── Wiring (optional — docker-compose.yml already sets these) ────────────────
# Override only for the bare-Python run path (see README "Run locally").

# DATAHUB_GMS_URL=http://localhost:8080
# DATAHUB_MCP_URL=http://localhost:8001/mcp   # containerised MCP server
# DATAHUB_MCP_TOKEN=
# DATAHUB_MCP_TOOL_TIMEOUT=60
# DATAHUB_MCP_ENABLE_MUTATIONS=false          # orchestrator-side write toggle
# DATAHUB_TELEMETRY_ENABLED=false             # avoids slow telemetry retries

# ── Session-memory database (optional — defaults match quickstart MySQL) ─────

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=datahub
# DB_PASSWORD=datahub

# ── PII tagging (optional) ──────────────────────────────────────────────────
# Column-level PII classifier / write-back tunables (see README "Tuning").

# PII_CLASSIFIER_MODEL=claude-haiku-4-5   # model for the residual pass
# PII_CLASSIFIER_MAX_TOKENS=1024
# PII_CONFIDENCE_FLOOR=0.6                 # below this a column is flagged uncertain, not written
# PII_PROPOSAL_TTL_SECONDS=1800            # how long a proposal stays confirmable
# PII_WRITE_TIMEOUT=20
